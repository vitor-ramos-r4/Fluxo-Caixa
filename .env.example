# ---------------------------------------------------------------------------
# Fluxo de Caixa — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com as credenciais do seu
# projeto Supabase (Dashboard > Project Settings > API).
# ---------------------------------------------------------------------------

# URL do projeto, no formato https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Chave pública (anon / publishable). É segura no cliente: o acesso aos dados
# é controlado por Row Level Security no banco.
VITE_SUPABASE_ANON_KEY=
